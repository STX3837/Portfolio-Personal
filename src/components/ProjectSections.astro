---
import type { ProjectContent } from '../data/projects';
import { copy, type Locale } from '../i18n/ui';
interface Props { content: ProjectContent; locale: Locale; technologies: string[] }
const { content, locale, technologies } = Astro.props;
const t = copy[locale];
const sources = [...new Map([...(content.references ?? []), ...(content.sections ?? []).flatMap(section => section.sources)].map(source => [source.href, source])).values()];
---
<div class="project-sections">
  <details class="technical-section">
    <summary><h2>{t.technicalDetails}</h2></summary>
    <div class="technical-content supplemental-grid">
      <section><h3>{t.architecture}</h3><ul>{content.architecture.map(item => <li>{item}</li>)}</ul></section>
      <section><h3>{content.featuresTitle ?? t.features}</h3><ul>{content.features.map(item => <li>{item}</li>)}</ul></section>
      {content.sections?.map(section => <section><h3>{section.title}</h3>{section.paragraphs.map(paragraph => <p>{paragraph}</p>)}<ul>{section.items.map(item => <li>{item}</li>)}</ul></section>)}
      <section><h3>{t.fullStack}</h3><ul class="tags">{technologies.map(item => <li>{item}</li>)}</ul></section>
    </div>
  </details>
  {sources.length > 0 && <details class="technical-section technical-references">
    <summary><h2>{t.references}</h2></summary>
    <nav class="technical-content evidence-links" aria-label={t.references}>{sources.map(source => <a href={source.href} target="_blank" rel="noopener noreferrer">{source.label} ↗</a>)}</nav>
  </details>}
</div>
