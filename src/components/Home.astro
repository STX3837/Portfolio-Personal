---
import { copy, type Locale } from '../i18n/ui';
import { profile, socialLinks, technologies, getCv } from '../data/profile';
import { projects } from '../data/projects';
import { localizedPath } from '../utils/routes';
import SocialLinks from './SocialLinks.astro';
import ProjectVisual from './ProjectVisual.astro';
interface Props { locale: Locale }
const { locale } = Astro.props; const t = copy[locale]; const cv = getCv(locale);
---
<main id="main">
 <section class="hero wrap" id="home" aria-labelledby="hero-title">
  <p class="eyebrow">{profile.name} <span aria-hidden="true">/</span> {t.role}</p>
  <h1 id="hero-title">{t.headline}</h1><p class="hero-description">{t.intro}</p>
  <div class="actions"><a class="button primary" href="#projects">{t.viewProjects} <span aria-hidden="true">↗</span></a><a class="button secondary" href="#contact">{t.contact}</a></div>
  <div class="hero-bottom"><p class="specialization">{t.specialization}</p><div class="social-links"><SocialLinks /></div></div>
 </section>
 <section class="section wrap" id="projects" aria-labelledby="projects-title"><div class="section-heading"><span class="section-number">01 /</span><div><p class="eyebrow">{t.selected}</p><h2 id="projects-title">{t.featured}</h2></div></div>
 <div class="project-grid">{projects.map((project, index) => <article class="project-card"><ProjectVisual project={project} locale={locale} index={index} /><div class="project-info"><h3>{project.content[locale].title}</h3><p>{project.content[locale].description}</p><ul class="tags" aria-label={t.technologies}>{project.tags.map(tag => <li>{tag}</li>)}</ul><div class="card-links"><a class="project-link" href={localizedPath(locale, `projects/${project.slug}/`)}>{t.details} <span aria-hidden="true">↗</span></a>{project.repositories ? <div class="card-repositories">{project.repositories.map(repository => <a href={repository.href} aria-label={`${t.viewCode} ${repository.label}`} target="_blank" rel="noopener noreferrer">{repository.label} ↗</a>)}</div> : project.repository && <a href={project.repository} target="_blank" rel="noopener noreferrer">{project.repositoryLabel?.[locale] ?? t.source} ↗</a>}</div></div></article>)}</div>
 </section>
 <section class="section wrap" id="about" aria-labelledby="about-title"><div class="section-heading"><span class="section-number">02 /</span><p class="eyebrow">{t.aboutLabel}</p></div><div class="about-grid"><h2 id="about-title">{t.aboutTitle}</h2><div><p class="about-text">{t.aboutText}</p><ul class="focus-list">{t.focus.map(item => <li>{item}</li>)}</ul></div></div>
 <div class="technology-section"><h3>{t.technologies}</h3><div class="technology-grid">{technologies.map((items, index) => <div><h4>{t.categories[index]}</h4><ul class="tags">{items.map(item => <li>{typeof item === 'string' ? item : item[locale]}</li>)}</ul></div>)}</div></div></section>
 <section class="section wrap contact-section" id="contact" aria-labelledby="contact-title"><div class="section-heading"><span class="section-number">03 /</span><p class="eyebrow">{t.contact}</p></div><h2 id="contact-title">{t.contactTitle}</h2><p>{profile.email || socialLinks.length ? t.contactText : t.contactEmpty}</p><div class="actions">{profile.email && <a class="button primary" href={`mailto:${profile.email}`} aria-label={`${t.mail}: ${profile.email}`}>{profile.email} <span aria-hidden="true">↗</span></a>}{cv && <a class="button secondary" href={cv.href} hreflang={cv.language} type="application/pdf" download>{locale === 'en' && cv.language === 'es' ? t.cvSpanish : t.cv} <span aria-hidden="true">↓</span></a>}</div><div class="social-links"><SocialLinks /></div></section>
</main>
