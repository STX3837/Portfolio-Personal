---
import { copy, type Locale } from '../i18n/ui';
interface Props { slug: string; index?: number; locale: Locale }
const { slug, index = 0, locale } = Astro.props;
---
<div class={`project-art art-${slug}`} aria-hidden="true"><span class="art-mark">0{index + 1} / {copy[locale].concept}</span><div class="art-diagram"><span></span><span></span><span></span><span></span><span></span></div><span class="art-caption">{slug === 'distans' ? 'DISTANS' : slug === 'aura' ? 'AURA' : 'EDC / DATA'}</span></div>
