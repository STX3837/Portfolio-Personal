# Set the actual production origin before building for deployment.
# Export SITE_URL in your shell or configure it in Vercel; this file is documentation.
# HTTPS required when VERCEL_ENV=production. No path, query, fragment or credentials.
# On Vercel (VERCEL=1), missing SITE_URL falls back to VERCEL_PROJECT_PRODUCTION_URL.
# Enable system environment variables in Vercel. Never use VERCEL_URL for canonical URLs.
SITE_URL=
